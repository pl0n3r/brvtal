Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Source/config files are not public assets. Deny direct HTTP access before
# canonical redirects and application routing; server-side PHP includes are safe.
RewriteRule ^(?:docs|config|database|scripts|tests|vendor|node_modules|\.github|\.factory)(?:/|$) - [F,L,NC]
RewriteRule ^(?:(?:datos|decisiones)\.yml|(?:composer|package)\.json|composer\.lock|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|(?:AGENTS|README)\.md|phpunit\.xml(?:\.dist)?)$ - [F,L,NC]

# Canonical production host. Keep this before internal routing so every public,
# API and DISCADMIN path converges on the same HTTPS www origin.
RewriteCond %{HTTP_HOST} ^brvtal\.com\.co(?::[0-9]+)?$ [NC]
RewriteRule ^ https://www.brvtal.com.co%{REQUEST_URI} [R=301,L,NE]

# Direct requests to /index.html, including percent-encoded variants, must
# never serve unexpanded partial markers. THE_REQUEST retains raw escapes;
# IS_SUBREQ exempts only the server's internal DirectoryIndex lookup.
RewriteCond %{IS_SUBREQ} =false
RewriteRule ^index\.html$ / [R=301,L,NE,QSD]

# Keep one public API implementation while supporting the compatibility aliases
# already declared by the public frontend loader.
RewriteRule ^api/public/?$ api/public.php [L,QSA,NC]
RewriteCond %{QUERY_STRING} (?:^|&)(?:route|action)=public(?:&|$) [NC]
RewriteRule ^api/index\.php$ api/public.php [L,QSA,NC]

# Expose one canonical public sitemap URL while keeping PHP as the internal renderer.
RewriteCond %{THE_REQUEST} \s/+sitemap\.php(?:[?\s]) [NC]
RewriteRule ^sitemap\.php$ /sitemap.xml [R=301,L,NE]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^indexnow-[A-Za-z0-9][A-Za-z0-9-]{0,90}\.txt$ indexnow-key.php [L,QSA,NC]

# ES keeps the established unprefixed canonical URLs. Explicit /es aliases
# converge there so the Spanish source never gains a duplicate indexable URL.
RewriteRule ^es/?$ / [R=301,L,NE]
RewriteRule ^es/contact/?$ /contact [R=301,L,NE]
RewriteRule ^es/privacy/?$ /privacy [R=301,L,NE]
RewriteRule ^es/(events|artists|sets|releases|blog|pages)/([a-z0-9-]+)/?$ /$1/$2 [R=301,L,NE]

# EN is the localized public alternate. Keep the home URL slashless so the
# legacy relative home assets continue to resolve from the web root.
RewriteRule ^en/$ /en [R=301,L,NE]
RewriteRule ^en$ index.php?locale=en [L,QSA,NC]
RewriteRule ^en/contact/?$ index.php?page=contact&locale=en [L,QSA,NC]
RewriteRule ^en/privacy/?$ index.php?page=privacy&locale=en [L,QSA,NC]
RewriteRule ^en/(events|artists|sets|releases|blog|pages)/([a-z0-9-]+)/?$ index.php?locale=en&type=$1&slug=$2 [L,QSA,NC]

RewriteRule ^contact/?$ index.php?page=contact [L,QSA,NC]
RewriteRule ^privacy/?$ index.php?page=privacy [L,QSA,NC]
RewriteRule ^preview/([a-f0-9]{48})/?$ preview.php?token=$1 [L,QSA,NC]
RewriteRule ^(events|artists|sets|releases|blog|pages)/([a-z0-9-]+)/?$ index.php?type=$1&slug=$2 [L,QSA,NC]

# Compress text responses at the web-server layer. LiteSpeed is Apache-compatible
# here, so this covers rendered PHP/HTML plus static CSS/JS/JSON/XML/SVG without
# wasting CPU on already-compressed photos, video or font binaries.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Security response headers for HTTPS on Apache/LiteSpeed.
    # No includeSubDomains/preload: other subdomains are outside this issue.
    Header always set Strict-Transport-Security "max-age=31536000"
    # PHP/FastCGI may place the header in either Apache header table.
    Header unset X-Powered-By
    Header always unset X-Powered-By
    # Existing public and DISCADMIN markup includes inline script/styles and
    # inline event attributes. Allow those until nonce/hash migration is scoped.
    Header unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://w.soundcloud.com https://open.spotify.com https://bandcamp.com; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

    # First-party CSS and JavaScript are deploy-versioned before delivery on both
    # the public site and DISCADMIN, so they can share immutable long-term caching.
    <FilesMatch "\.(?:css|js|png|jpe?g|gif|webp|avif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<FilesMatch "^\.(?:git|env|ht)">
    Require all denied
</FilesMatch>
