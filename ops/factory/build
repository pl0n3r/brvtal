#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"

case "$(factory_mode)" in
  fixture)
    factory_maybe_fail build
    root="$(factory_fixture_root)"
    sha="$(factory_sha)"
    version="$(factory_version)"
    release="$root/releases/$sha"
    mkdir -p -- "$release" "$release/database" "$release/config"
    cp -- "$BRVTAL_FACTORY_REPO_ROOT/config/migrations.php" "$release/config/migrations.php"
    tmp="$release/release.env.tmp.$$"
    {
      printf 'version=%s\n' "$version"
      printf 'sha=%s\n' "$sha"
    } > "$tmp"
    mv -f -- "$tmp" "$release/release.env"
    printf 'Built synthetic release %s\n' "$sha"
    ;;
  production)
    factory_require_production_activation
    factory_maybe_fail build
    sha="$(factory_sha)"
    version="$(factory_version)"
    cd "$BRVTAL_FACTORY_REPO_ROOT"
    head_sha="$(git rev-parse HEAD)"
    [[ "${head_sha,,}" == "$sha" ]] || factory_die "checkout HEAD must match GITHUB_SHA before packaging"
    archive="$(mktemp "${TMPDIR:-/tmp}/brvtal-factory-release.XXXXXX")"
    stage_root="$(mktemp -d "${TMPDIR:-/tmp}/brvtal-factory-stage.XXXXXX")"
    trap 'rm -rf -- "$stage_root"; rm -f -- "$archive"' EXIT
    git archive --format=tar "$sha" | tar -xf - -C "$stage_root"
    command -v composer >/dev/null 2>&1 || factory_die "composer is required to build the production release"
    COMPOSER_ALLOW_SUPERUSER=1 composer --working-dir="$stage_root" install \
      --no-dev --prefer-dist --no-interaction --no-progress \
      --optimize-autoloader --no-scripts --no-plugins
    [[ -f "$stage_root/vendor/autoload.php" ]] || factory_die "composer vendor autoload missing from candidate release"
    tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner \
      -C "$stage_root" -cf - . | gzip -n > "$archive"
    factory_transport stage --archive "$archive" --sha "$sha" --version "$version"
    printf 'Production release staged: %s\n' "$sha"
    ;;
  *)
    factory_die "adapter mode disabled; deploy transport credentials are not configured"
    ;;
esac
