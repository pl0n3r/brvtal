#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"

factory_require_fixture
factory_maybe_fail deploy
root="$(factory_fixture_root)"
sha="$(factory_sha)"
candidate="$root/releases/$sha"
[[ -f "$candidate/release.env" ]] || factory_die "candidate release missing"
[[ -f "$root/backups/$sha.ok" ]] || factory_die "backup marker missing before deploy"
if [[ "${MIGRATION_MODE:-none}" == "additive" ]]; then
  [[ -f "$root/migrations/$sha.ok" ]] || factory_die "migration marker missing before deploy"
elif [[ "${MIGRATION_MODE:-none}" != "none" ]]; then
  factory_die "unsupported migration mode"
fi

mkdir -p -- "$root/state"
current="$root/current"
if [[ -e "$current" && ! -L "$current" ]]; then
  factory_die "current release pointer must be a symlink"
fi

previous="__NONE__"
if [[ -L "$current" ]]; then
  previous="$(readlink "$current")"
  [[ -n "$previous" ]] || factory_die "current release pointer is empty"
  previous_resolved="$(readlink -f "$current")"
  case "$previous_resolved" in
    "$root"/releases/*) ;;
    *) factory_die "current release pointer escaped release root" ;;
  esac
fi
factory_atomic_write "$root/state/previous-release" "$previous"

tmp="$root/.current.$$"
ln -s -- "$candidate" "$tmp"
mv -Tf -- "$tmp" "$current"
printf 'Synthetic release activated: %s\n' "$sha"
