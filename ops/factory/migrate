#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"

[[ "${MIGRATION_MODE:-none}" == "additive" ]] || factory_die "migrate adapter only accepts MIGRATION_MODE=additive"

case "$(factory_mode)" in
  fixture)
    factory_maybe_fail migrate
    root="$(factory_fixture_root)"
    sha="$(factory_sha)"
    [[ -f "$root/backups/$sha.ok" ]] || factory_die "backup marker missing before migration"
    mkdir -p -- "$root/migrations"
    factory_atomic_write "$root/migrations/$sha.ok" "additive-migration-ready"
    printf 'Synthetic additive migration completed for %s\n' "$sha"
    ;;
  production)
    factory_require_production_activation
    factory_maybe_fail migrate
    sha="$(factory_sha)"
    migration="${BRVTAL_FACTORY_MIGRATION:-}"
    [[ "$migration" =~ ^migration_[a-z0-9_]+\.sql$ ]] || factory_die "BRVTAL_FACTORY_MIGRATION must name one explicit migration file"
    factory_transport migrate --sha "$sha" --migration "$migration"
    printf 'Remote additive migration completed for %s\n' "$sha"
    ;;
  *)
    factory_die "adapter mode disabled; deploy transport credentials are not configured"
    ;;
esac
